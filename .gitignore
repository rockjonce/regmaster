logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config
serviceAccountKey.json
firestore-debug.log

# Local backup snapshots (do not commit binaries / favicon copies)
_backup/

