{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "_comment": "Baseline security headers (M-5). Deliberately NO Content-Security-Policy: the app uses many inline <script> blocks + external origins (firebase, quickchart.io, ipapi.co, Google/LINE OAuth), so a strict CSP would break it; needs a dedicated effort with nonces/allowlist. No Permissions-Policy either (check-in uses the camera). X-Frame-Options:SAMEORIGIN is safe — the only iframes are same-origin srcdoc/data: previews.",
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "_comment": "Static media may be cached for a day.",
        "source": "**/*.@(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "_comment": "HTML / JS / CSS must always revalidate so fixes ship immediately (304 when unchanged). Prevents stale cached pages.",
        "source": "**/*.@(html|js|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
      },
      {
        "_comment": "Clean-URL admin routes (served via rewrites) — also no-cache.",
        "source": "/admin/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
      }
    ],
    "rewrites": [
      {
        "source": "/admin/events/*/edit",
        "destination": "/admin/events/edit.html"
      },
      {
        "source": "/admin/events/*/form-builder",
        "destination": "/admin/events/form-builder.html"
      },
      {
        "source": "/admin/events/*/announcements",
        "destination": "/admin/events/announcements.html"
      },
      {
        "source": "/admin/events/*/payments",
        "destination": "/admin/events/payments.html"
      },
      {
        "source": "/admin/events/*/registrations",
        "destination": "/admin/events/registrations.html"
      },
      {
        "source": "/admin/events/*/scoring",
        "destination": "/admin/events/scoring.html"
      },
      {
        "source": "/admin/events/*/checkin",
        "destination": "/admin/events/checkin.html"
      },
      {
        "source": "/admin/events/*/certificates",
        "destination": "/admin/events/certificates.html"
      },
      {
        "source": "/admin/events/*",
        "destination": "/admin/events/hub.html"
      },
      {
        "source": "/admin/super",
        "destination": "/admin/super.html"
      },
      {
        "_comment": "Legacy SPA fallback during the 3-month overlap (per Q6). Any path that doesn't match a static file falls through to legacy. New v3 root is public/index.html (was landing.html).",
        "source": "/legacy/**",
        "destination": "/legacy/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": []
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8085
    },
    "hosting": {
      "port": 5000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.7"
  }
}
